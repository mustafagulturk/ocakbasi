{
  "name": "ocakbasi",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ocakbasi/game",
    "dev:server": "npm run dev -w @ocakbasi/server",
    "build": "npm run build -w @ocakbasi/game",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/game && tsc -p packages/server"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
